#!/bin/bash
# 'kiosk' — return to the SSS2 touchscreen kiosk from a console/desktop session.
# Installed to /usr/local/bin/kiosk by scripts/setup-appliance.sh.
echo "Starting the SSS2 kiosk…"
# 'to-kiosk' also stops the desktop/DM so the kiosk can grab the seat (works from
# both a text console and the desktop). Falls back to a direct sudo start.
sudo -n /usr/local/sbin/sss2-kiosk-admin to-kiosk 2>/dev/null || sudo systemctl start sss2-kiosk
